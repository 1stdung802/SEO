# Sao chép file này thành secret.properties (cùng thư mục) rồi điền giá trị thật.
# secret.properties đã nằm trong .gitignore nên không bị đẩy lên GitHub.

# Mật khẩu tài khoản root của MySQL
spring.datasource.password=

# Gemini API key, lấy tại https://aistudio.google.com (mục API keys)
gemini.api.key=

# PageSpeed Insights API key, tạo tại Google Cloud Console (APIs & Services > Credentials)
pagespeed.api.key=
